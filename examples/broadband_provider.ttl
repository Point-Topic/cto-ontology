@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix cto: <https://github.com/Point-Topic/cto-ontology/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix qudt: <http://qudt.org/3.1.0/schema/qudt> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/> .

# Organization Types
ex:network_operator_type a cto:OrganizationType ;
    rdfs:label "Network Operator" .

ex:isp_type a cto:OrganizationType ;
    rdfs:label "ISP" .

# Network Types
ex:broadband_network_type a cto:NetworkType ;
    rdfs:label "Broadband Network" .

# Network Operator
ex:openreach a foaf:Organization ;
    rdfs:label "Openreach" ;
    cto:isOrganizationType ex:network_operator_type ;
    cto:isWholesaleOnly "true"^^xsd:boolean ;
    cto:ownsNetwork ex:openreach_fttp .

# Network
ex:openreach_fttp a cto:Network ;
    rdfs:label "Openreach FTTP Network" ;
    cto:isNetworkType ex:broadband_network_type ;
    cto:usesLink ex:fttp_link ;
    cto:usesLinkStandard ex:fttp_standard ;
    cto:hasCoverageArea ex:w2_1bt .

# Link Type and Standard
ex:fttp_link a cto:Link ;
    rdfs:label "FTTP Link" ;
    cto:supportsLinkStandard ex:fttp_standard .

ex:fttp_standard a cto:LinkStandard ;
    rdfs:label "FTTP Standard" .

# ISP
ex:sky a foaf:Organization ;
    rdfs:label "Sky" ;
    cto:isOrganizationType ex:isp_type ;
    cto:usesNetwork ex:openreach_fttp ;
    cto:offersService ex:sky_ultrafast .

# Broadband Service
ex:sky_ultrafast a cto:BroadbandService ;
    rdfs:label "Sky Ultrafast Broadband" ;
    cto:hasServiceName "Sky Ultrafast" ;
    cto:hasFastestDown "300 Mbps" ;
    cto:hasFastestUp "50 Mbps" ;
    cto:hasGuaranteedDown "100 Mbps" ;
    cto:hasMonthlyCost "35.00"^^xsd:float ;
    cto:hasSetupCost "0.00"^^xsd:float ;
    cto:hasBundleHomePhone "true"^^xsd:boolean ;
    cto:hasBundleVideo "false"^^xsd:boolean .

# Location
ex:w2_1bt a dcterms:Location ;
    rdfs:label "W2 1BT" ;
    geo:lat "51.5235"^^xsd:float ;
    geo:long "-0.1758"^^xsd:float . 