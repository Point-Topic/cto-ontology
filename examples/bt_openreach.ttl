@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix cto: <https://github.com/Point-Topic/cto-ontology/> .
@prefix geo: <http://www.w3.org/2003/01/geo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/> .

# Organization Types
ex:network_operator_type a cto:OrganizationType ;
    rdfs:label "Network Operator" .

ex:isp_type a cto:OrganizationType ;
    rdfs:label "ISP" .

# Network Types
ex:broadband_network_type a cto:NetworkType ;
    rdfs:label "Broadband Network" .

# Network Operator
ex:openreach a foaf:Organization ;
    rdfs:label "Openreach" ;
    cto:hasOrganizationTypeAssignment ex:openreach_type_assignment ;
    cto:hasWholesaleOnlyStatus ex:openreach_wholesale_status ;
    rdfs:comment "Openreach is a British telecommunications infrastructure company." .

ex:openreach_type_assignment a cto:OrganizationTypeAssignment ;
    cto:assignedOrganizationType ex:network_operator_type .

ex:openreach_wholesale_status a cto:WholesaleOnlyStatus ;
    cto:isWholesaleOnly "true"^^xsd:boolean .

ex:openreach_network_ownership a cto:NetworkOwnershipRelationship ;
    cto:ownerNetOp ex:openreach ;
    cto:ownsNetwork ex:openreach_fttp .

# ISP
ex:bt a foaf:Organization ;
    rdfs:label "BT" ;
    cto:hasOrganizationTypeAssignment ex:bt_type_assignment ;
    rdfs:comment "BT Group plc is a British telecommunications company." ;
    cto:offersBroadbandService ex:bt_full_fibre ;
    cto:validFrom "1846-01-01"^^xsd:date .

ex:bt_type_assignment a cto:OrganizationTypeAssignment ;
    cto:assignedOrganizationType ex:isp_type .

ex:bt_network_usage a cto:NetworkUsageRelationship ;
    cto:usedByISP ex:bt ;
    cto:usesNetwork ex:openreach_fttp .

# Network
ex:openreach_fttp a cto:Network ;
    rdfs:label "Openreach FTTP Network" ;
    cto:isNetworkType ex:broadband_network_type ;
    cto:usesLink ex:fttp ;
    cto:usesLinkStandard ex:fttp_standard .

# Link Type and Standard
ex:fttp a cto:Link ;
    rdfs:label "FTTP" ;
    cto:supportsLinkStandard ex:fttp_standard .

ex:fttp_standard a cto:LinkStandard ;
    rdfs:label "FTTP Standard" .

# Broadband Service
ex:bt_full_fibre a cto:BroadbandService ;
    rdfs:label "BT Full Fibre 900" ;
    cto:hasFastestDownloadSpeed "900"^^xsd:decimal ;
    cto:hasFastestUploadSpeed "110"^^xsd:decimal ;
    cto:hasGuaranteedDownloadSpeed "455"^^xsd:decimal ;
    cto:hasMonthlyCost "49.99"^^xsd:decimal ;
    cto:hasSetupCost "9.99"^^xsd:decimal ;
    cto:hasHomePhoneBundle "true"^^xsd:boolean ;
    cto:hasVideoBundle "false"^^xsd:boolean ;
    cto:hasTechnology ex:fttp ;
    cto:validFrom "2020-01-01"^^xsd:date .

# Locations
ex:uk a dcterms:Location ;
    rdfs:label "United Kingdom" ;
    geo:lat "55.3781"^^xsd:float ;
    geo:long "-3.4360"^^xsd:float .

ex:w2_1bt a dcterms:Location ;
    rdfs:label "W2 1BT" ;
    geo:lat "51.5235"^^xsd:float ;
    geo:long "-0.1758"^^xsd:float .
