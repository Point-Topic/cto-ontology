Class: qudt:DerivedUnit

    Annotations:
        rdfs:comment "A Derived Unit is a type specification for units that are derived from other units. Reused from QUDT ontology"^^xsd:string,
        rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt>,
        rdfs:label "derived unit"

    SubClassOf:
        <http://purl.obolibrary.org/obo/uo.owl/unit>


Class: qudt:MegaBIT-PER-SEC

    Annotations:
        rdfs:comment "A megabit per second (Mbit/s or Mb/s; not to be confused with mbit/s which means millibit per second, or with Mbitps which means megabit picosecond) is a unit of data transfer rate equal to 1,000,000 bits per second or 1,000 kilobits per second or 125,000 bytes per second or 125 kilobytes per second."^^xsd:string,
        rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit>,
        rdfs:label "megabit per second"
    
    SubClassOf:
        qudt:DerivedUnit


Class: qudt:GigaBIT-PER-SEC

    Annotations:
        rdfs:comment "A gigabit per second (Gbit/s or Gb/s) is a unit of data transfer rate equal to 1,000,000,000 bits per second."^^xsd:string,
        rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit>,
        rdfs:label "gigabit per second"
    
    SubClassOf:
        qudt:DerivedUnit
    
    
Class: <http://purl.org/vocommons/voaf#Vocabulary>
    
    
Class: <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>

    Annotations: 
        rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>
    
    SubClassOf: 
        cto:ConceptEntities

Class: dcterms:Location

    Annotations: rdfs:comment "A spatial region or named place."

    SubClassOf:
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>


Class: cto:Postcode

    Annotations: rdfs:comment "A postcode."

    SubClassOf:
        dcterms:Location

    
Class: foaf:Person

    Annotations: 
        rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>
    
    SubClassOf: 
        cto:PhysicalEntities
    
    DisjointWith: 
        foaf:Organization


Class: foaf:Organization

    Annotations: 
        rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>
    
    SubClassOf: 
        cto:PhysicalEntities

    DisjointWith: 
        foaf:Person


Class: cto:NonTelcoOrganization

    Annotations: 
        rdfs:comment "An organization whose primary function is not the direct provision of telecommunications services, such as a holding company, conglomerate, pension fund, hedge fund, or private equity firm."
    
    SubClassOf: 
        foaf:Organization


Class: cto:NetworkOperator

    Annotations: 
        rdfs:comment "telecommunications operator that manages its own network"
    
    SubClassOf: 
        foaf:Organization


Class: cto:ISP

    Annotations: 
        rdfs:comment "internet service provider that provides services to end-users"
    
    SubClassOf: 
        foaf:Organization


Class: om:ObservationAndMeasurement

    Annotations: 
        rdfs:comment "reused from SenSei Observation And Measurement Ontology (http://purl.oclc.org/net/unis/ontology/sensordata.owl)."^^xsd:string,
        rdfs:isDefinedBy <http://purl.oclc.org/net/unis/ontology/sensordata.owl>
    
    SubClassOf: 
        cto:ConceptEntities
    
    
Class: cto:ConceptEntities

    DisjointWith: 
        cto:PhysicalEntities


Class: cto:PhysicalEntities

    DisjointWith: 
        cto:ConceptEntities
    
    
Class: cto:Device

    Annotations: 
        rdfs:comment "represent all the devices in the physical infrastructure of telecommunciation system. 

According to its user, could be divided into UserDevice and SystemDevice."^^xsd:string
    
    SubClassOf: 
        cto:PhysicalInfrastructure
    
    
Class: cto:Link

Class: cto:Network

    SubClassOf: 
        cto:PhysicalInfrastructure
    
    
Class: cto:PhysicalInfrastructure

    Annotations: 
        rdfs:comment "Describe all the physical resources in a telecommunication network system, which is divided into three main modules, namely, device, interface, link (under network). 

Please be reminded the electromagnetic wave (which is the links of all wireless communication netwoks), even if it is invisable, physically exists. Thus, it is also described in the subclass of \"net;PhysicalInfrastructure\"."^^xsd:string
    
    DisjointWith: 
        cto:ConceptEntities

    SubClassOf:
        cto:PhysicalEntities
    
    
Class: cto:Service

    Annotations: 
        rdfs:comment "a communication service, e.g., voice, video, file uploading/downloading, etc."^^xsd:string
    
    SubClassOf: 
        cto:ConceptEntities
    
    
Class: cto:User

    Annotations: 
        rdfs:comment "reused from foaf (http://xmlns.com/foaf/0.1/). Represent a user in the telecommunication system."^^xsd:string
    
    SubClassOf: 
        foaf:Person
    
    
Class: cto:UserDevice

    Annotations: 
        rdfs:comment "User Devices, requiring connectivity services, e.g., phones, tablets, laptops, wearable devices, etc."^^xsd:string
    
    SubClassOf: 
        cto:Device
    
    
Class: cto:VideoService

    SubClassOf: 
        cto:Service
    
    
Class: cto:WiredLink

    Annotations: 
        rdfs:comment "wired link through twisted cable, optical fiber, etc."
    
    SubClassOf: 
        cto:Link
    
    DisjointWith: 
        cto:WirelessAssociation
    
    
Class: cto:WirelessAssociation

    Annotations: 
        rdfs:comment "the electromeganetic radio transmiting through wireless channels in wireless network, carring communication data. Depend on its frequency, it could be visiable light, micro waves, radio waves."^^xsd:string
    
    SubClassOf: 
        cto:Link
    
    DisjointWith: 
        cto:WiredLink
    
    
Class: cto:unReachable

    SubClassOf: 
        cto:UserDeviceStatus
    
    
Individual: cto:

    Types: 
        <http://purl.org/vocommons/voaf#Vocabulary>
    

Class: cto:adsl

    Annotations: 
        rdfs:comment "Asymmetric Digital Subscriber Line - a type of DSL broadband technology that uses existing telephone lines to transmit data with faster download than upload speeds."
    
    SubClassOf: 
        cto:WiredLink


Class: cto:cable

    Annotations: 
        rdfs:comment "Cable broadband connection that uses coaxial cable television infrastructure to provide internet access."
    
    SubClassOf: 
        cto:WiredLink


Class: cto:dialup

    Annotations: 
        rdfs:comment "Dial-up internet access that uses the facilities of the public switched telephone network (PSTN) to establish a connection to an ISP via telephone lines."
    
    SubClassOf: 
        cto:WiredLink


Class: cto:docsis_3

    Annotations: 
        rdfs:comment "Data Over Cable Service Interface Specification version 3.0 - a cable broadband standard that enables high-bandwidth data transfer."
    
    SubClassOf: 
        cto:cable


Class: cto:docsis_31

    Annotations: 
        rdfs:comment "Data Over Cable Service Interface Specification version 3.1 - an improved cable broadband standard with higher capacity than DOCSIS 3.0."
    
    SubClassOf: 
        cto:cable


Class: cto:docsis_4

    Annotations: 
        rdfs:comment "Data Over Cable Service Interface Specification version 4.0 - the latest cable broadband standard with significantly increased capacity and speeds."
    
    SubClassOf: 
        cto:cable


Class: cto:fttc

    Annotations: 
        rdfs:comment "Fiber to the Cabinet - a broadband connection where fiber optic cables run to a street cabinet, with the final connection to the premises using copper cables."
    
    SubClassOf: 
        cto:WiredLink


Class: cto:fttp

    Annotations: 
        rdfs:comment "Fiber to the Premises - a pure fiber optic connection running directly to homes or businesses, providing the highest available broadband speeds."
    
    SubClassOf: 
        cto:WiredLink


Class: cto:gfast

    Annotations: 
        rdfs:comment "G.fast - a digital subscriber line (DSL) protocol standard for local loops shorter than 500 m, offering speeds higher than VDSL2."
    
    SubClassOf: 
        cto:WiredLink


Class: cto:BroadbandService

    Annotations: 
        rdfs:comment "Broadband services provided to a fixed location associated with an address."
    
    SubClassOf: 
        cto:Service


Class: cto:CellularService

    Annotations: 
        rdfs:comment "Cellular services of all kinds, including data and voice, provided to mobile phones etc."
    
    SubClassOf: 
        cto:Service


Class: dcat:Catalog

    Annotations:
        rdfs:comment "A catalogue or repository that hosts the Datasets or Data Services being described."


Class: dcat:CatalogRecord

    Annotations:
        rdfs:comment "A description of a Catalogued Resource's entry in the Catalogue."


Class: dcat:Resource

    Annotations:
        rdfs:comment "Resource published or curated by a single agent."


Class: dcat:Dataset

    Annotations:
        rdfs:comment "A conceptual entity that represents the information published. In practice not limited to a dataset, can also be an article, webpage, etc."
    
    SubClassOf: 
        dcat:Resource


Class: dcat:DatasetSeries

    Annotations:
        rdfs:comment "A collection of datasets that are published separately, but share some characteristics that group them."
    
    SubClassOf: 
        dcat:Resource


Class: dcat:DataService

    Annotations:
        rdfs:comment "A collection of operations that provides access to one or more datasets or data processing functions."

    SubClassOf: 
        dcat:Resource


Class: <http://purl.obolibrary.org/obo/UO_0000190>

    Annotations: 
        rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl>,
        rdfs:label "dimensionless unit"
    
    SubClassOf: 
        <http://purl.obolibrary.org/obo/uo.owl/unit>
    
    
Class: <http://purl.obolibrary.org/obo/UO_0000187>

    Annotations: 
        rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl>,
        rdfs:label "percent",
        rdfs:comment "A dimensionless ratio unit which denotes numbers as fractions of 100."
    
    SubClassOf: 
        <http://purl.obolibrary.org/obo/UO_0000190>