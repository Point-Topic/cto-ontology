Datatype: rdf:PlainLiteral

    
Datatype: rdfs:Literal

    
Datatype: xsd:boolean

    
Datatype: xsd:dateTime

    
Datatype: xsd:float

    
Datatype: xsd:int

    
Datatype: xsd:string

    
ObjectProperty: <http://www.w3.org/2003/01/geo/wgs84_pos#location>

    Annotations: 
        rdfs:comment "The relation between something and the point, 
 or other geometrical thing in space, where it is.  For example, the realtionship between
 a radio tower and a Point with a given lat and long.
 Or a relationship between a park and its outline as a closed arc of points, or a road and
 its location as a arc (a sequence of points).
 Clearly in practice there will be limit to the accuracy of any such statement, but one would expect
 an accuracy appropriate for the size of the object and uses such as mapping .",
        rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>
    
    Domain: 
        cto:Device
    
    Range: 
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>
    
    
ObjectProperty: om:hasUnits

    Annotations: 
        rdfs:comment "the unit of an observation or measurement."^^xsd:string,
        rdfs:isDefinedBy <https://github.com/Point-Topic/cto-ontology/>
    
    Domain: 
        om:ObservationAndMeasurement
    
    Range: 
        <http://purl.obolibrary.org/obo/uo.owl/unit>
    
    
ObjectProperty: owl:topObjectProperty

    
    
ObjectProperty: cto:hasBandwidth

    Annotations: 
        rdfs:comment "the bandwidth of the link"^^xsd:string,
        rdfs:isDefinedBy <https://github.com/Point-Topic/cto-ontology/>
    
    SubPropertyOf: 
        cto:hasLinkProperty
    
    Domain: 
        cto:Link
    
    Range: 
        om:ObservationAndMeasurement
    
    
ObjectProperty: cto:hasWiredLink

    Annotations: 
        rdfs:comment "wired link through twisted cable, optical fiber, etc."
    
    SubPropertyOf: 
        cto:hasLink
    
    DisjointWith: 
        cto:hasWirelessAssociation
    
    Domain: 
        cto:Interface
    
    Range: 
        cto:WiredLink
    
    
ObjectProperty: cto:ownsNetwork

    Annotations: 
        rdfs:comment "network owned and operated by a network operator"
    
    Domain: 
        cto:NetworkOperator
    
    Range: 
        cto:Network


ObjectProperty: cto:usesNetwork

    Annotations: 
        rdfs:comment "the network an ISP utilises to sell its services over"
    
    Domain: 
        cto:ISP
    
    Range: 
        cto:Network


ObjectProperty: cto:hasCoverageArea

    Annotations: 
        rdfs:comment "areas covered by a network"
    
    Domain: 
        cto:Network
    
    Range: 
        dcterms:Location

ObjectProperty: cto:hasCoverage

    Annotations: 
        rdfs:comment "coverage level of a network (percentage, population, or otherwise)"
    
    Domain: 
        cto:Network
    
    Range: 
        om:ObservationAndMeasurement

ObjectProperty: cto:consolidatedInto

    Annotations: 
        rdfs:comment "Represents the relationship where one organiztion has been consolidated into another through merger, acquisition, or other business consolidation."
    
    Domain: 
        foaf:Organization
    
    Range: 
        foaf:Organization


ObjectProperty: cto:offersService

    Annotations: 
        rdfs:comment "Service offered to end users by an organisation."
    
    Range: 
        cto:Service

ObjectProperty: dcat:record

    Annotations: 
        rdfs:comment "A record describing the registration of a single resource (e.g., a dataset, a data service) that is part of the catalog."
    
    Domain: 
        dcat:Catalog
    
    Range: 
        dcat:CatalogRecord


# foaf:primaryTopic has Domain: dcat:CatalogRecord and Range: dcat:Resource in DCAT context. I am using it to relate a dcat:Resource to a foaf:Organization which is more useful in our context.
ObjectProperty: foaf:primaryTopic

    Annotations: 
        rdfs:comment "DCAT: The dcat:Resource (dataset or service) described in the record. FOAF: The primaryTopic property relates a document to the main thing that the document is about."

    Domain: 
        dcat:Resource

    Range:
        foaf:Organization
    

ObjectProperty: dcat:servesDataset

    Annotations:
        rdfs:comment "A collection of data that this data service can distribute."

    Domain:
        dcat:DataService

    Range:
        dcat:Dataset


ObjectProperty: dcat:inSeries

    Annotations:
        rdfs:comment "A dataset series of which the dataset is part."

    Domain:
        dcat:Dataset

    Range:
        dcat:DatasetSeries


ObjectProperty: dcat:geographicalCoverage

    Annotations:
        rdfs:comment "The geographical area covered by the dataset."

    Domain:
        dcat:Catalog

    Range:
        dcterms:Location


ObjectProperty: dcterms:publisher

    Annotations:
        rdfs:comment "The entity responsible for making the resource available."

    Domain:
        dcat:Catalog or dcat:Resource

    Range:
        foaf:Organization


DataProperty: <http://www.w3.org/2003/01/geo/wgs84_pos#alt>

    Annotations: 
        rdfs:comment "the altitude of a spatial thing, i.e., a point.",
        rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>
    
    Domain: 
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>
    
    Range: 
        xsd:float
    
    
DataProperty: <http://www.w3.org/2003/01/geo/wgs84_pos#lat>

    Annotations: 
        rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>,
        rdfs:isDefinedBy "the latitude of a point"
    
    Domain: 
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>
    
    Range: 
        xsd:float
    
    
DataProperty: <http://www.w3.org/2003/01/geo/wgs84_pos#long>

    Annotations: 
        rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>,
        rdfs:isDefinedBy "the longitude of a spatial thing, i.e., a point."
    
    Domain: 
        <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>
    
    Range: 
        xsd:float
    
    
DataProperty: foaf:firstName

    Annotations: 
        rdfs:comment "the first name of a user.",
        rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>
    
    Domain: 
        foaf:Person
    
    Range: 
        rdfs:Literal
    
    
DataProperty: foaf:gender

    Annotations: 
        rdfs:comment "the gender of a user, reused from foaf",
        rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>
    
    Domain: 
        foaf:Person
    
    Range: 
        rdfs:Literal
    
    
DataProperty: foaf:lastName

    Annotations: 
        rdfs:comment "the last name of a person.
Reused from foaf",
        rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>
    
    Domain: 
        foaf:Person
    
    Range: 
        rdfs:Literal
    
    
DataProperty: om:hasUnit

    Annotations: 
        rdfs:comment "reused from SENSEI Observation and Measurement Ontology."^^xsd:string,
        rdfs:isDefinedBy <http://purl.oclc.org/net/unis/ontology/sensordata.owl/>
    
    Domain: 
        om:ObservationAndMeasurement
    
    Range: 
        xsd:string
    
    
DataProperty: om:hasValue

    Annotations: 
        rdfs:comment "the value of an observation or measurement."^^xsd:string,
        rdfs:isDefinedBy <https://github.com/Point-Topic/cto-ontology/>
    
    Domain: 
        om:ObservationAndMeasurement
    
    Range: 
        xsd:float
    
    

    
DataProperty: cto:isWholesaler

    Annotations: 
        rdfs:comment "a network operator which does not offer services to end-users directly, but instead to ISPs, which then sell it on to end-users"
    
    Domain: 
        cto:NetworkOperator
    
    Range: 
        xsd:boolean


DataProperty: cto:isRetailer

    Annotations: 
        rdfs:comment "an ISP which does not control its own service infrastructure, but uses that of another organisation"
    
    Domain: 
        cto:ISP
    
    Range: 
        xsd:boolean

DataProperty: cto:hasServiceName

    Annotations: 
        rdfs:comment "The name of the service offer."
    
    Domain: 
        cto:Service
    
    Range: 
        xsd:string


DataProperty: cto:hasFastestDown

    Annotations: 
        rdfs:comment "The advertised download speed of the broadband service."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:string


DataProperty: cto:hasFastestUp

    Annotations: 
        rdfs:comment "The advertised upload speed of the broadband service."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:string


DataProperty: cto:hasGuaranteedUp

    Annotations: 
        rdfs:comment "The guaranteed minimum upload speed of the broadband service."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:string


DataProperty: cto:hasGuaranteedDown

    Annotations: 
        rdfs:comment "The guaranteed minimum download speed of the broadband service."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:string


DataProperty: cto:hasMonthlyCost

    Annotations: 
        rdfs:comment "The monthly cost of the service."
    
    Domain: 
        cto:Service
    
    Range: 
        xsd:float


DataProperty: cto:hasSetupCost

    Annotations: 
        rdfs:comment "The setup/installation cost of the broadband service."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:float


DataProperty: cto:hasBundleHomePhone

    Annotations: 
        rdfs:comment "Whether the broadband service includes a home phone bundle."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:boolean


DataProperty: cto:hasBundleMobilePhone

    Annotations: 
        rdfs:comment "Whether the broadband service includes a mobile phone bundle."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:boolean


DataProperty: cto:hasBundleVideo

    Annotations: 
        rdfs:comment "Whether the broadband service includes a TV/entertainment bundle."
    
    Domain: 
        cto:BroadbandService
    
    Range: 
        xsd:boolean


