@prefix : <http://www.w3.org/2002/07/owl#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos/> .
@prefix om: <https://bioportal.bioontology.org/ontologies/UO> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix cto: <https://github.com/Point-Topic/cto-ontology/> .
@prefix vann: <http://purl.org/vacob/vann/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/3.1.0/schema/qudt> .
@prefix dcat: <https://www.w3.org/TR/vocab-dcat-3/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://github.com/Point-Topic/cto-ontology/> a owl:Ontology ;
    cc:license <http://creativecommons.org/licenses/by/3.0/> ;
    dc:contributor <https://www.linkedin.com/in/oliver-johnson-1a3ba2/> ,
                   <https://www.linkedin.com/in/arnold-r-kürsteiner-4171981a2/> ,
                   <http://www.macs.hw.ac.uk/~ajg33/> ,
                   <https://www.eng.ed.ac.uk/about/people/mr-mohammad-dehghani-soltani> ,
                   <https://www.hw.ac.uk/staff/uk/eps/stephen-mclaughlin.htm> ,
                   <https://www.gla.ac.uk/schools/computing/staff/qianruzhou/> ;
    dc:creator <https://www.point-topic.com/> ;
    dc:description "A generalised ontology developed for telecommunciation industry" ;
    dc:issued "2024-7-1"^^xsd:date ;
    dc:modified "2024-7-1"^^xsd:date ;
    dc:publisher <https://www.point-topic.com/> ;
    dc:rights "Copyright  © 2024 Point Topic" ;
    dc:title "Common Telecoms Ontology"@en ;
    vann:preferredNamespacePrefix "cto" ;
    vann:preferredNamespaceUri "https://github.com/Point-Topic/cto-ontology/" ;
    rdfs:comment "Version 1.0: creation"@en ;
    owl:versionInfo 1.0 .

# Annotation Properties
cc:license a owl:AnnotationProperty .
dc:contributor a owl:AnnotationProperty .
dc:creator a owl:AnnotationProperty .
dc:description a owl:AnnotationProperty .
dc:issued a owl:AnnotationProperty .
dc:modified a owl:AnnotationProperty .
dc:publisher a owl:AnnotationProperty .
dc:rights a owl:AnnotationProperty .
dc:title a owl:AnnotationProperty .
owl:versionInfo a owl:AnnotationProperty .
rdfs:comment a owl:AnnotationProperty .
rdfs:isDefinedBy a owl:AnnotationProperty .
rdfs:label a owl:AnnotationProperty .
cto:contributor a owl:AnnotationProperty .
cto:license a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .

# Datatypes
rdf:PlainLiteral a rdfs:Datatype .
rdfs:Literal a rdfs:Datatype .
xsd:boolean a rdfs:Datatype .
xsd:dateTime a rdfs:Datatype .
xsd:float a rdfs:Datatype .
xsd:int a rdfs:Datatype .
xsd:string a rdfs:Datatype .

# Object Properties
geo:location a owl:ObjectProperty ;
    rdfs:comment """The relation between something and the point, 
 or other geometrical thing in space, where it is.  For example, the realtionship between
 a radio tower and a Point with a given lat and long.
 Or a relationship between a park and its outline as a closed arc of points, or a road and
 its location as a arc (a sequence of points).
 Clearly in practice there will be limit to the accuracy of any such statement, but one would expect
 an accuracy appropriate for the size of the object and uses such as mapping .""" ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:domain cto:Device ;
    rdfs:range geo:SpatialThing .

om:hasUnits a owl:ObjectProperty ;
    rdfs:comment "the unit of an observation or measurement."^^xsd:string ;
    rdfs:isDefinedBy <https://github.com/Point-Topic/cto-ontology/> ;
    rdfs:domain om:ObservationAndMeasurement ;
    rdfs:range <http://purl.obolibrary.org/obo/uo.owl/unit> .

owl:topObjectProperty a owl:ObjectProperty .

cto:ownsNetwork a owl:ObjectProperty ;
    rdfs:comment "network owned and operated by a network operator" ;
    rdfs:domain foaf:Organization ;
    rdfs:range cto:Network .

cto:usesNetwork a owl:ObjectProperty ;
    rdfs:comment "the network an ISP utilises to sell its services over" ;
    rdfs:domain foaf:Organization ;
    rdfs:range cto:Network .

cto:hasCoverageArea a owl:ObjectProperty ;
    rdfs:comment "areas covered by a network" ;
    rdfs:domain cto:Network ;
    rdfs:range dcterms:Location .

cto:hasCoverage a owl:ObjectProperty ;
    rdfs:comment "coverage level of a network (percentage, population, or otherwise)" ;
    rdfs:domain cto:Network ;
    rdfs:range om:ObservationAndMeasurement .

cto:isConsolidated a owl:ObjectProperty ;
    rdfs:comment "Indicates that one entity (organization or network) has been consolidated into another through merger, acquisition, or other business consolidation." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( foaf:Organization cto:Network ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( foaf:Organization cto:Network ) ] .

cto:hasCorporateRelationship a owl:ObjectProperty ;
    rdfs:comment "Relates one organization to another through a corporate relationship such as investment, ownership, partnership." ;
    rdfs:isDefinedBy <https://github.com/Point-Topic/cto-ontology/> ;
    rdfs:domain foaf:Organization ;
    rdfs:range foaf:Organization .

cto:offersService a owl:ObjectProperty ;
    rdfs:comment "Service offered to end users by an organisation." ;
    rdfs:range cto:Service .

cto:isOrganizationType a owl:ObjectProperty ;
    rdfs:comment "Relates an organization to its type classification (e.g., ISP, Network Operator, Non-Telco Organization)." ;
    rdfs:domain foaf:Organization ;
    rdfs:range cto:OrganizationType .

cto:isNetworkType a owl:ObjectProperty ;
    rdfs:comment "Relates a network to its type classification (e.g., Broadband Network, Satellite Network, Mobile Network, Hybrid Network, Other Network)." ;
    rdfs:domain cto:Network ;
    rdfs:range cto:NetworkType .

cto:usesLink a owl:ObjectProperty ;
    rdfs:comment "Relates a network to the link technology it uses." ;
    rdfs:domain cto:Network ;
    rdfs:range cto:Link .

cto:usesLinkStandard a owl:ObjectProperty ;
    rdfs:comment "Relates a network to the protocol/standard used by the physical link infrastructure." ;
    rdfs:domain cto:Network ;
    rdfs:range cto:LinkStandard .

cto:supportsLinkStandard a owl:ObjectProperty ;
    rdfs:comment "Relates a physical transmission medium/infrastructure link to the protocol/standard." ;
    rdfs:domain cto:Link ;
    rdfs:range cto:LinkStandard .

dcat:record a owl:ObjectProperty ;
    rdfs:comment "A record describing the registration of a single resource (e.g., a dataset, a data service) that is part of the catalog." ;
    rdfs:domain dcat:Catalog ;
    rdfs:range dcat:CatalogRecord .

foaf:primaryTopic a owl:ObjectProperty ;
    rdfs:comment "DCAT: The dcat:Resource (dataset or service) described in the record. FOAF: The primaryTopic property relates a document to the main thing that the document is about." ;
    rdfs:domain dcat:Resource ;
    rdfs:range foaf:Organization .

dcat:servesDataset a owl:ObjectProperty ;
    rdfs:comment "A collection of data that this data service can distribute." ;
    rdfs:domain dcat:DataService ;
    rdfs:range dcat:Dataset .

dcat:inSeries a owl:ObjectProperty ;
    rdfs:comment "A dataset series of which the dataset is part." ;
    rdfs:domain dcat:Dataset ;
    rdfs:range dcat:DatasetSeries .

dcat:geographicalCoverage a owl:ObjectProperty ;
    rdfs:comment "The geographical area covered by the dataset." ;
    rdfs:domain dcat:Catalog ;
    rdfs:range dcterms:Location .

dcterms:publisher a owl:ObjectProperty ;
    rdfs:comment "The entity responsible for making the resource available." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( dcat:Catalog dcat:Resource ) ] ;
    rdfs:range foaf:Organization .

cto:isPublisher a owl:ObjectProperty ;
    rdfs:comment "An organization responsible for making a catalogued resource available." ;
    rdfs:domain foaf:Organization ;
    rdfs:range dcat:CataloguedResource .

cto:hasRecord a owl:ObjectProperty ;
    rdfs:comment "A catalogue record that is part of the catalogue." ;
    rdfs:domain dcat:Catalog ;
    rdfs:range dcat:Dataset .

# Data Properties
geo:alt a owl:DatatypeProperty ;
    rdfs:comment "the altitude of a spatial thing, i.e., a point." ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:domain geo:SpatialThing ;
    rdfs:range xsd:float .

geo:lat a owl:DatatypeProperty ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ,
                     "the latitude of a point" ;
    rdfs:domain geo:SpatialThing ;
    rdfs:range xsd:float .

geo:long a owl:DatatypeProperty ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ,
                     "the longitude of a spatial thing, i.e., a point." ;
    rdfs:domain geo:SpatialThing ;
    rdfs:range xsd:float .

foaf:firstName a owl:DatatypeProperty ;
    rdfs:comment "the first name of a user." ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
    rdfs:domain foaf:Person ;
    rdfs:range rdfs:Literal .

foaf:lastName a owl:DatatypeProperty ;
    rdfs:comment """the last name of a person.
Reused from foaf""" ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
    rdfs:domain foaf:Person ;
    rdfs:range rdfs:Literal .

om:hasUnit a owl:DatatypeProperty ;
    rdfs:comment "reused from SENSEI Observation and Measurement Ontology."^^xsd:string ;
    rdfs:isDefinedBy <http://purl.oclc.org/net/unis/ontology/sensordata.owl/> ;
    rdfs:domain om:ObservationAndMeasurement ;
    rdfs:range xsd:string .

om:hasValue a owl:DatatypeProperty ;
    rdfs:comment "the value of an observation or measurement."^^xsd:string ;
    rdfs:isDefinedBy <https://github.com/Point-Topic/cto-ontology/> ;
    rdfs:domain om:ObservationAndMeasurement ;
    rdfs:range xsd:float .

cto:isWholesaler a owl:DatatypeProperty ;
    rdfs:comment "a network operator which does not offer services to end-users directly, but instead to ISPs, which then sell it on to end-users" ;
    rdfs:domain foaf:Organization ;
    rdfs:range xsd:boolean .

cto:isRetailer a owl:DatatypeProperty ;
    rdfs:comment "an ISP which does not control its own service infrastructure, but uses that of another organisation" ;
    rdfs:domain foaf:Organization ;
    rdfs:range xsd:boolean .

cto:hasServiceName a owl:DatatypeProperty ;
    rdfs:comment "The name of the service offer." ;
    rdfs:domain cto:Service ;
    rdfs:range xsd:string .

cto:hasFastestDown a owl:DatatypeProperty ;
    rdfs:comment "The advertised download speed of the broadband service." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:string .

cto:hasFastestUp a owl:DatatypeProperty ;
    rdfs:comment "The advertised upload speed of the broadband service." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:string .

cto:hasGuaranteedUp a owl:DatatypeProperty ;
    rdfs:comment "The guaranteed minimum upload speed of the broadband service." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:string .

cto:hasGuaranteedDown a owl:DatatypeProperty ;
    rdfs:comment "The guaranteed minimum download speed of the broadband service." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:string .

cto:hasMonthlyCost a owl:DatatypeProperty ;
    rdfs:comment "The monthly cost of the service." ;
    rdfs:domain cto:Service ;
    rdfs:range xsd:float .

cto:hasSetupCost a owl:DatatypeProperty ;
    rdfs:comment "The setup/installation cost of the broadband service." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:float .

cto:hasBundleHomePhone a owl:DatatypeProperty ;
    rdfs:comment "Whether the broadband service includes a home phone bundle." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:boolean .

cto:hasBundleMobilePhone a owl:DatatypeProperty ;
    rdfs:comment "Whether the broadband service includes a mobile phone bundle." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:boolean .

cto:hasBundleVideo a owl:DatatypeProperty ;
    rdfs:comment "Whether the broadband service includes a TV/entertainment bundle." ;
    rdfs:domain cto:BroadbandService ;
    rdfs:range xsd:boolean .

cto:corporateRelationshipType a owl:DatatypeProperty ;
    rdfs:comment "The type of corporate relationship (e.g., 'investment', 'ownership', 'subsidiary')." ;
    rdfs:isDefinedBy <https://github.com/Point-Topic/cto-ontology/> ;
    rdfs:domain foaf:Organization ;
    rdfs:range xsd:string .

cto:consolidationAnnouncedDate a owl:DatatypeProperty ;
    rdfs:comment "The date when the consolidation, merger, or acquisition was publicly announced." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( foaf:Organization cto:Network ) ] ;
    rdfs:range xsd:date .

cto:consolidationCompletedDate a owl:DatatypeProperty ;
    rdfs:comment "The date when the consolidation, merger, or acquisition was legally completed and became effective." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( foaf:Organization cto:Network ) ] ;
    rdfs:range xsd:date .

cto:validFrom a owl:DatatypeProperty ;
    rdfs:comment "The date from which this entity or relationship is valid." ;
    rdfs:range xsd:date .

cto:validTo a owl:DatatypeProperty ;
    rdfs:comment "The date until which this entity or relationship is valid." ;
    rdfs:range xsd:date .

cto:comment a owl:DatatypeProperty ;
    rdfs:comment "Additional information or comments about this entity." ;
    rdfs:range xsd:string .

cto:origin a owl:DatatypeProperty ;
    rdfs:comment "The source or origin of this data (e.g., 'asserted', 'inferred')." ;
    rdfs:range xsd:string .

cto:hasSubscribers a owl:DatatypeProperty ;
    rdfs:comment "Specifies the number of subscribers for a network." ;
    rdfs:domain cto:Network ;
    rdfs:range xsd:integer .

cto:isRetailOnly a owl:DatatypeProperty ;
    rdfs:comment "Specifies whether an organization is retail-only (does not own any network infrastructure)." ;
    rdfs:domain foaf:Organization ;
    rdfs:range xsd:boolean .

cto:isWholesaleOnly a owl:DatatypeProperty ;
    rdfs:comment "Specifies whether an organization is only wholesale (does not sell services directly to end-users)." ;
    rdfs:domain foaf:Organization ;
    rdfs:range xsd:boolean .

cto:isBusinessOnly a owl:DatatypeProperty ;
    rdfs:comment "Specifies whether an organization is business-only (exclusively sells to business customers)." ;
    rdfs:domain foaf:Organization ;
    rdfs:range xsd:boolean .

cto:isNetworkSegment a owl:DatatypeProperty ;
    rdfs:comment "Indicates whether a network represents a segment or part of a larger network infrastructure, rather than a complete network." ;
    rdfs:domain cto:Network ;
    rdfs:range xsd:boolean .

# Classes
<http://purl.obolibrary.org/obo/UO_0000001> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "length unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000003> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "time unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000008> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "meter" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000001> .

<http://purl.obolibrary.org/obo/UO_0000010> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "second" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000003> .

<http://purl.obolibrary.org/obo/UO_0000016> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "millimeter" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000001> .

<http://purl.obolibrary.org/obo/UO_0000017> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "micrometer" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000001> .

<http://purl.obolibrary.org/obo/UO_0000028> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "millisecond" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000003> .

<http://purl.obolibrary.org/obo/UO_0000031> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "minute" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000003> .

<http://purl.obolibrary.org/obo/UO_0000032> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "hour" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000003> .

<http://purl.obolibrary.org/obo/UO_0000034> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "week" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000003> .

<http://purl.obolibrary.org/obo/UO_0000035> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "month" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000003> .

<http://purl.obolibrary.org/obo/UO_0000036> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "year" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000003> .

<http://purl.obolibrary.org/obo/UO_0000058> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "rotational frequency unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000105> .

<http://purl.obolibrary.org/obo/UO_0000060> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "speed/velocity unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000092> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "turns per second" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000058> .

<http://purl.obolibrary.org/obo/UO_0000094> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "meter per second" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000060> .

<http://purl.obolibrary.org/obo/UO_0000105> a owl:Class ;
    rdfs:label "frequency unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000106> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "hertz" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000105> .

<http://purl.obolibrary.org/obo/UO_0000111> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "energy unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000113> a owl:Class ;
    rdfs:label "power unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000114> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "watt" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000113> .

<http://purl.obolibrary.org/obo/UO_0000190> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "dimensionless unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000187> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "percent" ;
    rdfs:comment "A dimensionless ratio unit which denotes numbers as fractions of 100." ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000190> .

<http://purl.obolibrary.org/obo/UO_0000223> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "watt-hour" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000111> .

<http://purl.obolibrary.org/obo/UO_0000224> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "kilowatt-hour" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000111> .

<http://purl.obolibrary.org/obo/UO_0000231> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "information unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

<http://purl.obolibrary.org/obo/UO_0000232> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "bit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000231> .

<http://purl.obolibrary.org/obo/UO_0000233> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "byte" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000231> .

<http://purl.obolibrary.org/obo/UO_0000235> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "megabyte" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000231> .

<http://purl.obolibrary.org/obo/UO_0000325> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "megaHertz" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000105> .

<http://purl.obolibrary.org/obo/UO_0000331> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "gigabyte" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000231> .

<http://purl.obolibrary.org/obo/UO_0000332> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "terabyte" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000231> .

<http://purl.obolibrary.org/obo/UO_0010005> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "millimeters per day" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000060> .

<http://purl.obolibrary.org/obo/UO_0010008> a owl:Class ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:label "kilometer per hour" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/UO_0000060> .

<http://purl.obolibrary.org/obo/uo.owl/unit> a owl:Class ;
    rdfs:comment "reused from Units of measurement Ontology"^^xsd:string ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/uo.owl> ;
    rdfs:subClassOf cto:ConceptualEntity .

qudt:DerivedUnit a owl:Class ;
    rdfs:comment "A Derived Unit is a type specification for units that are derived from other units. Reused from QUDT ontology"^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.0.0/schema/qudt> ;
    rdfs:label "derived unit" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/uo.owl/unit> .

qudt:MegaBIT-PER-SEC a owl:Class ;
    rdfs:comment "A megabit per second (Mbit/s or Mb/s; not to be confused with mbit/s which means millibit per second, or with Mbitps which means megabit picosecond) is a unit of data transfer rate equal to 1,000,000 bits per second or 1,000 kilobits per second or 125,000 bytes per second or 125 kilobytes per second."^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> ;
    rdfs:label "megabit per second" ;
    rdfs:subClassOf qudt:DerivedUnit .

qudt:GigaBIT-PER-SEC a owl:Class ;
    rdfs:comment "A gigabit per second (Gbit/s or Gb/s) is a unit of data transfer rate equal to 1,000,000,000 bits per second."^^xsd:string ;
    rdfs:isDefinedBy <http://qudt.org/3.1.0/vocab/unit> ;
    rdfs:label "gigabit per second" ;
    rdfs:subClassOf qudt:DerivedUnit .

<http://purl.org/vocommons/voaf#Vocabulary> a owl:Class .

geo:SpatialThing a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#> ;
    rdfs:subClassOf cto:ConceptualEntity .

dcterms:Location a owl:Class ;
    rdfs:comment "A spatial region or named place." ;
    rdfs:subClassOf geo:SpatialThing .

cto:Country a owl:Class ;
    rdfs:comment "A nation with its own government, occupying a particular territory." ;
    rdfs:subClassOf dcterms:Location .

cto:Address a owl:Class ;
    rdfs:comment "An address, irrespective of format." ;
    rdfs:subClassOf dcterms:Location .

foaf:Person a owl:Class ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
    rdfs:subClassOf cto:PhysicalEntity ;
    owl:disjointWith foaf:Organization .

foaf:Organization a owl:Class ;
    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
    rdfs:subClassOf cto:PhysicalEntity ;
    owl:disjointWith foaf:Person .

cto:OrganizationType a owl:Class ;
    rdfs:comment "A classification type for organizations based on their role in the telecom industry (e.g., ISP, Network Operator, Non-Telco Organization)." ;
    rdfs:subClassOf cto:ConceptualEntity .

om:ObservationAndMeasurement a owl:Class ;
    rdfs:comment "reused from SenSei Observation And Measurement Ontology (http://purl.oclc.org/net/unis/ontology/sensordata.owl)."^^xsd:string ;
    rdfs:isDefinedBy <http://purl.oclc.org/net/unis/ontology/sensordata.owl> ;
    rdfs:subClassOf cto:ConceptualEntity .

cto:ConceptualEntity a owl:Class ;
    rdfs:comment "A conceptual entity. Generally, an entity that does not occupy space in the physical world. Mutually exclusive with physical entities." ;
    owl:disjointWith cto:PhysicalEntity .

cto:PhysicalEntity a owl:Class ;
    rdfs:comment "A physical entity. Generally, an entity that occupies space in the physical world. Mutually exclusive with conceptual entities." ;
    owl:disjointWith cto:ConceptualEntity .

cto:Device a owl:Class ;
    rdfs:comment "represent all the devices in the physical infrastructure of telecommunciation system."^^xsd:string ;
    rdfs:subClassOf cto:PhysicalInfrastructure .

cto:Link a owl:Class ;
    rdfs:comment "The physical transmission medium or infrastructure type used to connect a premises or network endpoint to the broadband access network." ;
    rdfs:subClassOf cto:PhysicalEntity .

cto:LinkStandard a owl:Class ;
    rdfs:comment "The data transmission standard or protocol used over the physical transmission medium/infrastructure (Link) to deliver broadband connectivity." ;
    rdfs:subClassOf cto:ConceptualEntity .

cto:Network a owl:Class ;
    rdfs:subClassOf cto:PhysicalInfrastructure .

cto:NetworkType a owl:Class ;
    rdfs:comment "A classification type for networks based on their technology and service delivery method (e.g., Broadband Network, Satellite Network, Mobile Network, Hybrid Network, Other Network)." ;
    rdfs:subClassOf cto:ConceptualEntity .

cto:PhysicalInfrastructure a owl:Class ;
    rdfs:comment """Describe all the physical resources in a telecommunication network system, which is divided into two main modules, namely, device and link (under network). 

Please be reminded the electromagnetic wave (which is the links of all wireless communication netwoks), even if it is invisable, physically exists. Thus, it is also described in the subclass of "net;PhysicalInfrastructure"."""^^xsd:string ;
    owl:disjointWith cto:ConceptualEntity ;
    rdfs:subClassOf cto:PhysicalEntity .

cto:Service a owl:Class ;
    rdfs:comment "a communication service, e.g., voice, video, file uploading/downloading, etc."^^xsd:string ;
    rdfs:subClassOf cto:ConceptualEntity .

cto:User a owl:Class ;
    rdfs:comment "reused from foaf (http://xmlns.com/foaf/0.1/). Represent a user in the telecommunication system."^^xsd:string ;
    rdfs:subClassOf foaf:Person .

cto:UserDevice a owl:Class ;
    rdfs:comment "User Devices, requiring connectivity services, e.g., phones, tablets, laptops, wearable devices, etc."^^xsd:string ;
    rdfs:subClassOf cto:Device .

cto:VideoService a owl:Class ;
    rdfs:subClassOf cto:Service .

cto:WiredLink a owl:Class ;
    rdfs:comment "wired link through twisted cable, optical fiber, etc." ;
    rdfs:subClassOf cto:Link ;
    owl:disjointWith cto:WirelessAssociation .

cto:WirelessAssociation a owl:Class ;
    rdfs:comment "the electromeganetic radio transmiting through wireless channels in wireless network, carring communication data. Depend on its frequency, it could be visiable light, micro waves, radio waves."^^xsd:string ;
    rdfs:subClassOf cto:Link ;
    owl:disjointWith cto:WiredLink .

cto:BroadbandService a owl:Class ;
    rdfs:comment "Broadband services provided to a fixed location associated with an address." ;
    rdfs:subClassOf cto:Service .

cto:CellularService a owl:Class ;
    rdfs:comment "Cellular services of all kinds, including data and voice, provided to mobile phones etc." ;
    rdfs:subClassOf cto:Service .

dcat:Catalog a owl:Class ;
    rdfs:comment "A catalogue or repository that hosts the Datasets or Data Services being described." .

dcat:CatalogRecord a owl:Class ;
    rdfs:comment "A description of a Catalogued Resource's entry in the Catalogue." .

dcat:CataloguedResource a owl:Class ;
    rdfs:comment "A resource published or curated by a single agent." ;
    rdfs:subClassOf cto:ConceptualEntity .

dcat:Resource a owl:Class ;
    rdfs:comment "Resource published or curated by a single agent." ;
    rdfs:subClassOf dcat:CataloguedResource .

dcat:Dataset a owl:Class ;
    rdfs:comment "A conceptual entity that represents the information published. In practice not limited to a dataset, can also be an article, webpage, etc." ;
    rdfs:subClassOf dcat:CataloguedResource .

dcat:DatasetSeries a owl:Class ;
    rdfs:comment "A collection of datasets that are published separately, but share some characteristics that group them." ;
    rdfs:subClassOf dcat:CataloguedResource .

dcat:DataService a owl:Class ;
    rdfs:comment "A collection of operations that provides access to one or more datasets or data processing functions." ;
    rdfs:subClassOf dcat:CataloguedResource .

# Individual
cto: a <http://purl.org/vocommons/voaf#Vocabulary> .
